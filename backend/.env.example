# Change YOUR_PASSWORD to your local postgres password.
# Make sure a database called "paynest" exists.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/paynest?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-this-to-any-long-random-string"
PORT=4000
CLIENT_URL="http://localhost:3000"
